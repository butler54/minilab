# A more formal description of this format can be found here:
# https://github.com/validatedpatterns/common/tree/main/ansible/roles/vault_utils#values-secret-file-format

version: "2.0"
# Ideally you NEVER COMMIT THESE VALUES TO GIT (although if all passwords are
# automatically generated inside the vault this should not really matter)

secrets:
  - name: sample
    vaultPrefixes:
    - hub
    fields:
    - name: key
      value: ''
      onMissingValue: generate
      vaultPolicy: validatedPatternDefaultPolicy
  - name: pagerduty-routing-key
    vaultPrefixes:
    - global
    fields:
    - name: key
      value: ''
      onMissingValue: prompt
      vaultPolicy: validatedPatternDefaultPolicy
  # OpenShell feature (006) — G0 seeds in quickstart.md:
  # Cloudflare API token for ACME DNS-01 (Zone:DNS Edit + Zone:Zone Read on global.dnsZone)
  - name: openshell-cloudflare
    vaultPrefixes:
    - hub
    fields:
    - name: api-token
      value: ''
      onMissingValue: prompt
      vaultPolicy: validatedPatternDefaultPolicy
  # Gateway credential-storage KEK; auto-generate once, never rotate casually
  # (rotation invalidates provider credentials stored in the gateway)
  - name: openshell-gateway-kek
    vaultPrefixes:
    - hub
    fields:
    - name: kek
      value: ''
      onMissingValue: generate
      vaultPolicy: validatedPatternDefaultPolicy
  # OpenAI API key for the demonstration coding agent (US5)
  - name: openshell-openai
    vaultPrefixes:
    - hub
    fields:
    - name: api-key
      value: ''
      onMissingValue: prompt
      vaultPolicy: validatedPatternDefaultPolicy
  # Keycloak IdP (rh-keycloak app) — operator-side secrets:
  #   admin-password: Keycloak bootstrap admin (KC admin console login).
  #   db-password:    PostgreSQL 'keycloak' user password (in-cluster DB).
  # These are infrastructure secrets, NOT identity sources — users log in
  # to the openshell realm exclusively via GitHub.
  - name: openshell-keycloak
    vaultPrefixes:
    - hub
    fields:
    - name: admin-password
      value: ''
      onMissingValue: generate
      vaultPolicy: validatedPatternDefaultPolicy
    - name: db-password
      value: ''
      onMissingValue: generate
      vaultPolicy: validatedPatternDefaultPolicy
  # GitHub OAuth App backing the realm's GitHub identity provider.
  # Create at https://github.com/settings/developers with callback
  # https://keycloak.tokyo-brunch.com/realms/openshell/broker/github/endpoint
  - name: openshell-github-oauth
    vaultPrefixes:
    - hub
    fields:
    - name: client-id
      value: ''
      onMissingValue: prompt
      vaultPolicy: validatedPatternDefaultPolicy
    - name: client-secret
      value: ''
      onMissingValue: prompt
      vaultPolicy: validatedPatternDefaultPolicy
